# Oracle Database Connection Settings
# Replace the placeholder values below with your actual Oracle SQL database credentials.
# Save a copy of this file as '.env' in the project root directory.

# Oracle User / Schema Name
ORACLE_USER=your_oracle_username

# Oracle Password
ORACLE_PASSWORD=your_oracle_password

# Oracle Database Host (e.g., localhost or 127.0.0.1 for local Oracle XE/Enterprise)
ORACLE_HOST=localhost

# Oracle Listener Port (default for Oracle is usually 1521)
ORACLE_PORT=1521

# Oracle Service Name (e.g., XEPDB1, XE, ORCL, FREEPDB1) OR SID
ORACLE_SERVICE_NAME=XEPDB1

# Optional: Flask Server Port and Debug mode
FLASK_PORT=5000
FLASK_DEBUG=True
